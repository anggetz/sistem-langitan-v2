{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "metronic:build:js": "webpack --mode=development",
        "metronic:build:css": "npx tailwindcss -i ./resources/metronic/css/styles.css -o ./public/assets/css/styles.css",
        "metronic:build:css:watch": "npx tailwindcss -i ./resources/metronic/css/styles.css -o ./public/assets/css/styles.css --watch",
        "metronic:build:prod": "npx tailwindcss -i ./resources/metronic/css/styles.css -o ./public/assets/css/styles.css --minify && npx webpack --env production",
        "metronic:build": "npm run metronic:build:css && npm run metronic:build:js --mode=development",
        "metronic:lint": "npx eslint src/core --ext .ts"
    },
    "devDependencies": {
        "@babel/core": "^7.26.0",
        "@babel/preset-env": "^7.26.0",
        "@eslint/js": "^9.14.0",
        "@inertiajs/vue3": "^2.0.0",
        "@popperjs/core": "^2.11.8",
        "@vitejs/plugin-vue": "^5.0.0",
        "apexcharts": "^4.0.0",
        "autoprefixer": "^10.4.20",
        "axios": "^1.7.7",
        "babel-loader": "^9.2.1",
        "clean-webpack-plugin": "^4.0.0",
        "clipboard": "^2.0.11",
        "concurrently": "^9.0.1",
        "copy-webpack-plugin": "^12.0.2",
        "css-loader": "^7.1.2",
        "eslint": "^9.14.0",
        "esri-leaflet": "^3.0.13",
        "esri-leaflet-geocoder": "^3.1.5",
        "laravel-vite-plugin": "^1.2.0",
        "mini-css-extract-plugin": "^2.9.2",
        "mini-svg-data-uri": "^1.4.4",
        "postcss": "^8.4.49",
        "postcss-import": "^16.1.0",
        "postcss-loader": "^8.1.1",
        "postcss-nesting": "^13.0.1",
        "postcss-preset-env": "^10.1.0",
        "sort-package-json": "^2.14.0",
        "source-map-loader": "^5.0.0",
        "style-loader": "^4.0.0",
        "tailwindcss": "^3.4.14",
        "terser-webpack-plugin": "^5.3.10",
        "ts-loader": "^9.5.1",
        "typescript": "^5.6.3",
        "vite": "^6.0.11",
        "vue": "^3.4.0",
        "webpack": "^5.95.0",
        "webpack-cli": "^5.1.4",
        "webpack-merge-and-include-globally": "^2.3.4"
    }
}
