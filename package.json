{
    "private": true,
    "type": "module",
    "scripts": {
        "start": "concurrently --names vite,php -c \"#f7df1e,#aeb2d5\" \"npm run dev\" \"php artisan serve\"",
        "dev": "vite",
        "build": "vite build && npm run build:css:prod",
        "build:css": "npx tailwindcss -i ./resources/metronic/css/styles.css -o ./public/assets/css/styles.css",
        "build:css:watch": "npx tailwindcss -i ./resources/metronic/css/styles.css -o ./public/assets/css/styles.css --watch",
        "build:css:prod": "npx tailwindcss -i ./resources/metronic/css/styles.css -o ./public/assets/css/styles.css --minify"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^2.0.5",
        "@tailwindcss/forms": "^0.5.3",
        "@vitejs/plugin-vue": "^5.0.0",
        "apexcharts": "^4.5.0",
        "autoprefixer": "^10.4.21",
        "axios": "^1.6.4",
        "concurrently": "^9.1.2",
        "laravel-vite-plugin": "^1.0.0",
        "mini-svg-data-uri": "^1.4.4",
        "postcss": "^8.5.3",
        "postcss-import": "^16.1.0",
        "postcss-loader": "^8.1.1",
        "postcss-nesting": "^13.0.1",
        "tailwindcss": "^3.4.17",
        "vite": "^5.0.0",
        "vite-plugin-copy": "^0.1.6",
        "vue": "^3.4.0"
    },
    "dependencies": {
        "@popperjs/core": "^2.11.8",
        "portal-vue": "^3.0.0"
    }
}
